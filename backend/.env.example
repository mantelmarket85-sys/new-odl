# Local development environment (this file is gitignored — .env.example is the committed template)
#
# SQLite: paths resolve relative to the schema directory (backend/prisma/),
# so ./prisma/dev.db = backend/prisma/prisma/dev.db — the pre-seeded database
# shipped with the repo (125 tables + demo accounts). No seeding needed.
DATABASE_URL="file:./prisma/dev.db"

# Required for JWT sign/verify (any long random string).
JWT_SECRET="change-me-to-a-long-random-string"

PORT=5000
FRONTEND_URL="http://localhost:5174"
